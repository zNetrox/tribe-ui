{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "@tribe/ui": {
      "projectType": "library",
      "root": "projects/tribe/ui",
      "sourceRoot": "projects/tribe/ui",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "projects/tribe/ui/tsconfig.lib.json",
            "outputPath": "dist/tribe/ui"
          },
          "configurations": {
            "production": {},
            "development": {
              "compilationMode": "full",
              "declarationMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/tribe/ui/tsconfig.spec.json"
          }
        },
        "storybook": {
          "builder": "@storybook/angular-vite:start-storybook",
          "options": {
            "configDir": "projects/tribe/ui/.storybook",
            "browserTarget": "@tribe/ui:build",
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular-vite:build-storybook",
          "options": {
            "configDir": "projects/tribe/ui/.storybook",
            "browserTarget": "@tribe/ui:build",
            "outputDir": "storybook-static"
          }
        }
      }
    }
  }
}
